# Browser-side environment for the ReMediX frontend (Vite).
# Copy to frontend/.env (or frontend/.env.local) and adjust.

# Base URL of the backend API. Empty string means same-origin (dev proxy /
# SPA served by FastAPI). Set to your API host when the frontend is deployed
# separately, e.g. https://api.remedix.example.com
VITE_API_BASE_URL=
