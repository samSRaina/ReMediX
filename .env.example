# ReMediX backend + SPA host environment configuration
# Copy to .env and adjust. All variables are optional unless noted.

# --- CORS ---------------------------------------------------------------
# Comma-separated list of allowed origins for the API.
# REQUIRED in production (Netlify frontend + separate API host).
# Example: ALLOWED_ORIGINS=https://remedix.netlify.app,https://main--remedix.netlify.app
ALLOWED_ORIGINS=

# Optional single regex alternative to the origin list, e.g. ^https://.*\.netlify\.app$
ALLOWED_ORIGIN_REGEX=

# --- Server -------------------------------------------------------------
# Interface/port uvicorn binds (usually set via CLI/platform, not here).
# HOST=0.0.0.0
# PORT=8000

# --- Postgres (docker-compose; unused by the app today, reserved for the
#     planned data migration) --------------------------------------------
POSTGRES_USER=remedix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=remedix
# POSTGRES_PORT=5432

# --- Notes --------------------------------------------------------------
# VITE_API_BASE_URL (frontend/.env) controls the browser-side API base URL.
# See frontend/.env.example.
